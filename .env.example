# n8n webhook that receives click_created and lead_created events
N8N_WEBHOOK_URL=https://n8n.example.com/webhook/wa-attribution

# Optional Shlink API integration
SHLINK_API_URL=https://shlink.example.com
SHLINK_API_KEY=replace-with-your-shlink-api-key

# Optional fallback redirect behavior
DEFAULT_WHATSAPP_PHONE=5511999999999
DEFAULT_REDIRECT_URL=https://example.com

# Optional admin protection for read-only operational endpoints
ADMIN_TOKEN=replace-with-a-random-admin-token
